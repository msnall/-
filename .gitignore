node_modules
dist
build
.DS_Store
.env

# Local transcription tool checkout, compiled binaries and downloaded models.
/bin/whisper.cpp/

# Reproducible working media and generated audio stems.
/public/derived/

# Ignore the output video from Git but not videos you import into src/.
out

# Review desk: preview proxies and their machine-specific record, job records
# and logs are regenerated locally.
/public/projects/*/proxy/
# Uploaded video/audio assets stay outside Git like the recordings
# (assets.json records their SHA-256); stills are small and tracked.
/public/projects/*/assets/*.mp4
/public/projects/*/assets/*.mov
/public/projects/*/assets/*.wav
/public/projects/*/assets/*.mp3
/projects/*/analysis/proxies.json
/projects/*/jobs/
/projects/*/logs/

# Original talent footage stays outside Git; scripts verify it by SHA-256.
/public/recordings/**/*.mp4
/public/recordings/**/*.mov

{
  "id": "keyword-punch@1",
  "name": "关键词推近",
  "category": "rhythm",
  "status": "ready",
  "source": ["tk-common", "pdf#14"],
  "description": "说到关键词（痛点、结果、产品名）时画面推近 1.1–1.2 倍，约 1 秒后回落。",
  "when": { "roles": ["hook", "intro", "pain", "benefit", "proof", "product", "dose", "offer", "cta"], "position": "any" },
  "slots": {
    "word": { "type": "word", "label": "推近落在哪个词上（词序号）" },
    "zoom": { "type": "number", "label": "推近倍数", "min": 1.05, "max": 1.3, "default": 1.15 }
  },
  "template": {
    "punchIns": [{ "at": { "word": "$word", "expect": "$expect" }, "durationFrames": 30, "zoom": "$zoom", "rampFrames": 5 }]
  },
  "tunables": { "zoom": { "label": "推近倍数", "range": [1.05, 1.3] } },
  "rules": [
    { "check": "maxPerVideo", "value": 4 },
    { "text": "两次推近之间至少隔 4 秒；词离段落结尾不足 1 秒时不要用（推近会被剪断）" }
  ]
}

          "shots": []
        },
        {
          "id": "b05",
          "text": "I literally just snapped one photo of my lunch.",
          "lengthMs": 1367,
          "zoom": 1.15,
          "shots": []
        },
        {
          "id": "b06",
          "text": "A few seconds after I snap the photo, the AI coach tells me something based on what's actually on my plate.",

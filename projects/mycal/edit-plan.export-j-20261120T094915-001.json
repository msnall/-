          "zoom": 1.2,
          "shots": [
            "screen-o1|0|150|40|170|320|693"
          ]
        },
        {
          "id": "b07",
          "text": "I just read it out loud, then it makes a recipe and a grocery list for me.",
          "lengthMs": 3833,
          "zoom": 1,
          "shots": [
            "screen-o1|0|108|590|170|320|693"
          ]
        },
        {
          "id": "b08",

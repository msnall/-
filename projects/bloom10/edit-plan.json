    "fontSize": 58,
    "lineHeight": 70,
    "fontWeight": 700,
    "color": "#231b22",
    "activeColor": "#9f3262",
    "wordGap": 13,
    "maxLines": 2,
    "singleLineMaxChars": 24,
    "balanceWeight": 0.2

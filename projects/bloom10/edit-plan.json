{
  "schemaVersion": 1,
  "id": "bloom10",
  "meta": {
    "title": "Bloom10 English UGC, first cut r1",
    "baseline": "git tag bloom10-r1, out/bloom10-first-cut/Bloom10-first-cut-r1.mp4",
    "preparedBy": "npm.cmd run prepare:bloom10 (frames + mix.wav in public/derived/bloom10)",
    "audio": "mix.wav is already mastered by prepare:bloom10 (voice -16 LUFS, limiter), so post-render normalization stays off to keep r1 audio unchanged.",
    "notes": "Reproduces the reviewed r1 cut. Title cards use output frames chosen during r1 review; the second card waits for the packaging label to finish at frame 323."
  },
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "encoding": { "crf": 18, "x264Preset": "veryfast" }
  },
  "theme": {
    "background": "#fff8fb",
    "textColor": "#231b22",
    "fontFamily": "\"BloomInter\", sans-serif",
    "fonts": [{ "family": "BloomInter", "src": "fonts/Inter-700.woff2", "weight": 700 }]
  },
  "assets": {
    "source": {
      "type": "video",
      "path": "recordings/Bloom10/Bloom10-达人素材.mp4",
      "sha256": "31bf76ef1375c072f53117d2379660d40973ed323d61037d34afc3786a8274c3"
    },
    "main": {
      "type": "imageSequence",
      "dir": "derived/bloom10/frames",
      "pattern": "frame-%04d.jpg",
      "frameCount": 909,
      "fps": 30
    },
    "label": {
      "type": "video",
      "path": "effects/packaging-label.webm",
      "sha256": "948be1edce7d7f5752a14ce4919365d6a7349279cad513faa4de4d836c2ef37d"
    },
    "mix": { "type": "audio", "path": "derived/bloom10/mix.wav" }
  },
  "transcript": {
    "asset": "main",
    "words": "transcripts/Bloom10-达人素材.edited.json",
    "cues": "transcripts/Bloom10-达人素材.edited.cues.json"
  },
  "segments": [{ "id": "full", "asset": "main", "sourceStartMs": 0, "sourceEndMs": 30300 }],
  "layout": {
    "footage": { "x": 43, "y": 38, "width": 842, "height": 1498, "borderRadius": 18, "fit": "fill" }
  },
